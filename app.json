{
  "expo": {
    "name": "Kitchen Co.",
    "slug": "kitchen-co",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kitchenco",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitchenco.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#AF1718"
      },
      "package": "com.kitchenco.app"
    },
    "web": {
      "bundler": "metro",
      "viewport": {
        "width": "device-width",
        "height": "device-height",
        "initialScale": 1,
        "maximumScale": 1,
        "userScalable": false
      },
      "backgroundColor": "#AF1718",
      "themeColor": "#2B0B98"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-mail-composer",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#AF1718"
        }
      ]
    ],
    "primaryColor": "#2B0B98",
    "androidStatusBar": {
      "backgroundColor": "#2B0B98",
      "barStyle": "light-content"
    }
  }
}
